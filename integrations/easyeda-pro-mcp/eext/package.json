{
	"name": "pro-api-sdk",
	"version": "1.3.2",
	"description": "嘉立创EDA & EasyEDA 专业版扩展 API 开发工具",
	"author": "JLCEDA <support@lceda.cn>",
	"license": "Apache-2.0",
	"homepage": "https://pro.lceda.cn/",
	"engines": {
		"node": ">=20.17.0"
	},
	"scripts": {
		"compile": "rimraf ./dist/ && ts-node ./config/esbuild.prod.ts",
		"typecheck": "tsc --noEmit",
		"lint": "eslint",
		"fix": "eslint --fix",
		"build": "pnpm run compile && ts-node ./build/packaged.ts"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.2.0",
		"@jlceda/pro-api-types": "^0.4.0",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^26.1.2",
		"@typescript/native": "npm:typescript@^7.0.2",
		"esbuild": "^0.28.1",
		"eslint": "^10.8.0",
		"fs-extra": "^11.4.0",
		"ignore": "^7.0.6",
		"jszip": "^3.10.1",
		"lint-staged": "^17.3.0",
		"rimraf": "^6.1.3",
		"simple-git-hooks": "^2.13.1",
		"ts-node": "^10.9.2",
		"typescript": "npm:@typescript/typescript6@~6.0.2"
	},
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged"
	},
	"lint-staged": {
		"*": "eslint --fix"
	}
}
