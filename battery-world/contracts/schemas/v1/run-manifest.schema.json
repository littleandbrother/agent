{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://battery-world.local/contracts/v1/run-manifest.schema.json",
  "title": "Battery World Run Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "world_hash", "event_head", "scientific_hash", "phases", "recovery_count", "inventory", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "bfworld-run-manifest-v1"},
    "run_id": {"type": "string"},
    "world_hash": {"type": "string"},
    "event_head": {"type": "string"},
    "scientific_hash": {"type": "string"},
    "phases": {"type": "object"},
    "recovery_count": {"type": "integer", "minimum": 0},
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "claim_boundary": {"type": "string"}
  }
}

